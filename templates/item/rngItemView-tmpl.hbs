<div class="module__header--last">
    <h4>RING MOD</h4>
</div>
<div class="module__control-group">
    <div class="label-container">
        <span class="label--wide">FREQ</span>
        <span class="label--wide">MIX</span>
    </div>
    <div class="fader-container">
        <div class="fader">
            <div class="fader__scale--heavy"></div>
            <div class="fader__scale--light">
                <div class="fader__slot">
                    <div class="fader__knob midi" data-param="rng-freq" data-value="0">
                        <hr>
                    </div>
                </div>
                <div class="fader__slot">
                    <div class="fader__knob midi" data-param="rng-mix" data-value="0">
                        <hr>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="module__switch-control-group">
    <div class="knob-container--pwm">
        <span class="label--line">_________</span>
        <div class="line"></div>
        <p class="label">OFF</p>
        <div class="switch">
            <div class="switch__knob midi" data-param="rng-active" data-value="0" data-length="2"></div>
        </div>
        <p class="label">ON</p>
    </div>
</div>
